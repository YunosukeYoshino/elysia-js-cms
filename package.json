{
  "name": "elysiajs-demo",
  "version": "1.0.0",
  "description": "A lightweight CMS API built with ElysiaJS",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "NODE_ENV=production bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --external @prisma/client --external sharp",
    "seed": "bun run src/scripts/seed.ts",
    "migrate-passwords": "bun run src/scripts/migrate-passwords.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "format": "bun biome format --write .",
    "lint": "bun biome lint .",
    "check": "bun biome check .",
    "lint:fix": "bun biome check --write .",
    "typecheck": "bun tsc --noEmit --skipLibCheck",
    "prepare-db:dev": "bun src/scripts/prepare-db.ts development",
    "prepare-db:test": "NODE_ENV=test bun src/scripts/prepare-db.ts test",
    "prepare": "husky",
    "pre-commit": "lint-staged && bun test",
    "test:artifact": "bun run build && bun scripts/smoke-artifact.ts"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "biome check --write .",
      "biome format --write"
    ]
  },
  "keywords": [
    "elysiajs",
    "cms",
    "api",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/html": "1.4.2",
    "@elysiajs/jwt": "1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "6.19.3",
    "elysia": "1.4.30",
    "formidable": "^3.5.4",
    "ioredis": "^6.0.0",
    "mime-types": "^3.0.2",
    "sharp": "0.35.5",
    "uuid": "13.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/formidable": "^3.4.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/web": "^0.0.266",
    "bun-types": "1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
